FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json requirements.txt ./
RUN npm ci --omit=dev && python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt
COPY src ./src
COPY tools/remote-bridge.mjs tools/start-cloud.mjs ./tools/
COPY public ./public
RUN mkdir -p .private && chown -R node:node /app
USER node
ENV ARYANA_BRIDGE_HOST=0.0.0.0 ARYANA_BRIDGE_PORT=4322 ARYANA_PYTHON=/opt/venv/bin/python
EXPOSE 4322
CMD ["node","tools/start-cloud.mjs"]
