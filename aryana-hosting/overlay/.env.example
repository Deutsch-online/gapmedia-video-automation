# Optional external chat model. Leave disabled unless you choose its provider.
ARYANA_LLM_ENABLED=false
ARYANA_LLM_URL=
ARYANA_LLM_MODEL=
ARYANA_LLM_KEY=
# Optional explicit Python path; normally the local .venv is used.
# ARYANA_PYTHON=C:\path\to\python.exe

# Optional OFFLINE talking-clip renderer. This is not realtime lip sync.
# ARYANA_AVATAR_PYTHON=C:\path\to\aryana-live\.avatar-env\Scripts\python.exe
# ARYANA_SADTALKER_ROOT=C:\path\to\aryana-live\.avatar-models\SadTalker
