+const size=360,cx=180,cy=215,radius=94;
+const smooth=(a,b,x)=>{const q=Math.max(0,Math.min(1,(x-a)/(b-a)));return q*q*(3-2*q);};
+const grid=new Float32Array(16384);
+let seed=43012;
+for(let i=0;i<grid.length;i++){seed=(Math.imul(seed,1664525)+1013904223)|0; grid[i]=(seed>>>0)/4294967296;}
+function noise(x,y){
+ const i=Math.floor(x),j=Math.floor(y),a=smooth(0,1,x-i),b=smooth(0,1,y-j);
+ const u=grid[(i&127)+(j&127)*128],v=grid[((i+1)&127)+(j&127)*128];
+ const w=grid[(i&127)+((j+1)&127)*128],z=grid[((i+1)&127)+((j+1)&127)*128];
+ return (u+(v-u)*a)*(1-b)+(w+(z-w)*a)*b;
+}
+function turbulence(x,y){return .58*noise(x,y)+.27*noise(2.1*x+13,2.1*y-8)+.15*noise(4.1*x-15,4.1*y+9);}
+export function renderFireFrame(ctx,pixels,t){
+ const data=pixels.data, resolution=pixels.width, scale=size/resolution;
+ data.fill(0);
+ const burst=Math.pow(Math.max(0,Math.sin(t*2)),7);
+ const wind=.15*Math.sin(t)+.10*Math.sin(3*t);
+ for(let row=0;row<resolution;row++)for(let column=0;column<resolution;column++){
+  const x=column*scale,y=row*scale;
+  const dx=x-cx,dy=y-cy,r=Math.hypot(dx,dy),distance=r-radius;
+  if(distance<1||distance>112)continue;
+  const theta=Math.atan2(dy,dx);
+  const up=Math.max(0,-dy);
+  const bend=up*(.10+wind)+7*Math.sin(up*.045+t*2);
+  const fireAngle=Math.atan2(dy,dx-bend);
+  const fireSide=Math.pow(Math.max(0,-Math.sin(fireAngle)),2.65);
+  const smokeSide=Math.pow(Math.max(0,Math.cos(theta+2.32-wind)),.8);
+  if(!fireSide&&!smokeSide)continue;
+  const driftX=.17*t+.65*Math.cos(t),driftY=.47*t+.45*Math.sin(t);
+  const nx=(x-bend)/22+driftX,ny=y/30+driftY;
+  const curl=turbulence(nx+5.2,ny+7.8);
+  const heat=turbulence(nx*1.31+curl*2.6,ny*1.46-curl*3.4);
+  const rise=Math.max(0,-dy)/radius;
+  const length=6+fireSide*(41+32*burst)+9*rise;
+  const strands=.65+.29*Math.sin(fireAngle*26+t*4+curl*8)+.12*Math.sin(fireAngle*47-t*5);
+  const edge=length*Math.max(.22,strands)*(.58+heat*.76);
+  const flame=fireSide*smooth(0,4,distance)*(1-smooth(edge*.22,edge,distance))*smooth(.22,.72,heat+(.55-distance/edge)*.31);
+  const smokeNoise=turbulence(nx*.71+curl*2+8,ny*.74+curl*2-7);
+  const bank=smokeSide*smooth(2,22,distance)*(1-smooth(28,104,distance))*smooth(.34,.76,smokeNoise);
+  if(flame<.008&&bank<.008)continue;
+  const fade=smooth(0,32,Math.min(x,y,size-1-x,size-1-y));
+  const k=(row*resolution+column)*4;
+  if(flame>bank*.82){
+   const hot=Math.min(1,Math.max(0,flame*.87+.43-distance/(edge*1.42)));
+   data[k]=255;data[k+1]=Math.round(28+207*hot);data[k+2]=Math.round(10+155*hot**2);
+   data[k+3]=Math.round(Math.min(.97,flame*1.7)*255*fade);
+  }else{
+   data[k]=Math.round(29+63*smokeNoise);data[k+1]=Math.round(60+114*smokeNoise);data[k+2]=Math.round(92+132*smokeNoise);
+   data[k+3]=Math.round(Math.min(.54,bank*1.2)*255*fade);
+  }
+ }
+ ctx.putImageData(pixels,0,0);
+}
+
+const frames=new Set();
+let raf=0,last=-Infinity;
+function paint(time){
+ if(time-last>=52){
+  last=time;
+  for(const frame of frames){
+   if(!frame.canvas.isConnected){frames.delete(frame);continue;}
+   if(!frame.canvas.getClientRects().length||frame.canvas.closest('.frames-expired,[hidden]'))continue;
+   renderFireFrame(frame.ctx,frame.pixels,time/620+frame.offset);
+  }
+ }
+ raf=frames.size?requestAnimationFrame(paint):0;
+}
+
+export function addTopFireFrame(host){
+ if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;
+ const canvas=document.createElement('canvas');
+ canvas.className='top-fire-effect';
+ canvas.setAttribute('aria-hidden','true');
+ canvas.width=canvas.height=180;
+ const ctx=canvas.getContext('2d');
+ if(!ctx)return;
+ host.prepend(canvas);
+ const frame={canvas,ctx,pixels:ctx.createImageData(canvas.width,canvas.height),offset:Math.random()*3};
+ frames.add(frame);
+ if(!raf)raf=requestAnimationFrame(paint);
+}
