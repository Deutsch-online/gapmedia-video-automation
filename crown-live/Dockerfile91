FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng python3 python3-venv && rm -rf /var/lib/apt/lists/*
COPY voice-install.py /tmp/voice-install.py
RUN python3 /tmp/voice-install.py /opt/crown-voice && rm /tmp/voice-install.py
WORKDIR /home/node/app
COPY --chown=node:node package*.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY --chown=node:node server.mjs live-bridge.mjs assets-manifest.json voice-backup.py ./
COPY --chown=node:node public ./public
USER node
ENV PORT=7860
EXPOSE 7860
CMD ["node","server.mjs"]
