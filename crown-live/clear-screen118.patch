+.screen #broadcast #liveActivityLane > #spotlightCard:not([hidden]) {
+  grid-column: 1;
+  grid-row: 1;
+}
+.screen #broadcast #liveActivityLane > #arrivalBanner:not([hidden]) {
+  grid-column: 2;
+  grid-row: 1;
+  justify-self: start;
+  margin-left: calc((100% - min(100%,440px)) * var(--lane-x,1));
+  translate: 0 var(--lane-y,0px);
+}
+.screen #liveActivityLane :is(.arrival-portrait,.spotlight-portrait) {
+  grid-column: 1;
+  grid-row: 1 / span 2;
+}
+.screen #broadcast #liveActivityLane :is(.arrival-portrait,.spotlight-portrait) {
+  width: clamp(56px,calc(60px * var(--bubble-scale,1)),78px);
+  height: auto;
+  aspect-ratio: 1;
+  margin: 0;
+}
+.screen #broadcast #liveActivityLane :is(h2,h3) {
+  grid-column: 2;
+  grid-row: 1;
+  margin: 0;
+  font-size: 22px;
+  color: #ffdfa0;
+  text-align: start;
+}
+.screen #broadcast #liveActivityLane :is(.arrival-name,.spotlight-name) {
+  grid-column: 2;
+  grid-row: 2;
+  min-width: 0;
+  max-width: 100%;
+  margin: 0;
+  color: #fff;
+  font-size: 27px;
+  line-height: 1.1;
+  text-align: start;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.screen #liveActivityLane .arrival-note,
+.screen #liveActivityLane .spotlight-time,
+.screen #liveActivityLane .arrival-time,
+.screen #broadcast #showJoinTicker { display: none; }
+.screen #broadcast #showResponseBand {
+  flex-basis: 112px;
+  min-height: 112px;
+}
+.screen #broadcast .show-boards {
+  flex-basis: 212px;
+  height: 212px;
+  gap: 10px;
+}
+.screen #broadcast .show-board h3 {
+  font-size: 32px;
+  margin-bottom: 7px;
+}
+.screen #broadcast .show-board .row {
+  height: 45px;
+  min-height: 45px;
+  font-size: 32px;
+}
+.screen #broadcast .show-board .row>b {
+  color: #fff0ac;
+  font-size: 31px;
+}
+.screen #broadcast #answerHint {
+  color: #fff0ad;
+}
+
+.screen #broadcast #liveActivityLane > #spotlightCard[data-kind="support"]:not([hidden]) {
+  grid-template-columns: 94px minmax(0,1fr);
+  border: 2px solid #ffcc68;
+  background: radial-gradient(ellipse at 12% 50%, #613414 0%, #251426 55%, #171333 100%);
+  box-shadow: inset 0 0 18px #ffaa3d35;
+}
+.screen #broadcast #liveActivityLane #spotlightCard[data-kind="support"] .spotlight-portrait {
+  width: 82px;
+  border: 3px solid #ffe59e;
+  box-shadow: 0 0 0 3px #a55822, 0 0 15px #ffb944b3;
+  animation: gift-frame-glow 2.5s ease-in-out infinite alternate;
+}
+@keyframes gift-frame-glow {
+  to { box-shadow: 0 0 0 3px #db8737, 0 0 20px #ffd263e6; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .screen #broadcast #liveActivityLane #spotlightCard[data-kind="support"] .spotlight-portrait {
+    animation: none;
+  }
+}
