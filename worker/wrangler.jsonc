    "GITHUB_OWNER": "Deutsch-online",
    "GITHUB_REPO": "gapmedia-video-automation",
    "GITHUB_WORKFLOW": "telegram.yml"
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    { "binding": "BOT_STATE", "id": "b9d8cdbf80af49b7987f59b7a9b09c01" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
