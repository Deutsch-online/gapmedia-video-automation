# Telegram delivery — copy this file to «.env» and fill in your own values.
# Videos are sent automatically after each daily render when both are set.

# 1) Bot token from @BotFather (Telegram): create a bot, copy the token.
TELEGRAM_BOT_TOKEN=123456789:ABCdEfGhIjKlMnOpQrStUvWxYz

# 2) Target chat id:
#    - Channel: add the bot as ADMIN, then use @your_channel_username
#    - Group/DM: message the bot once, open
#      https://api.telegram.org/bot<TOKEN>/getUpdates  and copy chat.id (a number)
TELEGRAM_CHAT_ID=@your_channel_username

# Reddit — رایگان: در reddit.com/prefs/apps یک app از نوع "script" بسازید
REDDIT_CLIENT_ID=
REDDIT_SECRET=

# Exa — the only PAID image index in LAW 7 (layer 3). Off by default so a
# build costs nothing: Pexels, Wikimedia, DuckDuckGo, Pollinations, our own
# assets and the local graphic are all keyless or free-tier. The key stays
# registered; set the flag to true to spend on it.
ENABLE_EXA=false
EXA_API_KEY=
