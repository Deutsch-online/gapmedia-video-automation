# Telegram delivery — copy this file to «.env» and fill in your own values.
# Videos are sent automatically after each daily render when both are set.

# 1) Bot token from @BotFather (Telegram): create a bot, copy the token.
TELEGRAM_BOT_TOKEN=123456789:ABCdEfGhIjKlMnOpQrStUvWxYz

# 2) Target chat id:
#    - Channel: add the bot as ADMIN, then use @your_channel_username
#    - Group/DM: message the bot once, open
#      https://api.telegram.org/bot<TOKEN>/getUpdates  and copy chat.id (a number)
# ALL traffic runs through the bot: this is your own one-to-one chat with
# it, not a channel and not a group. `node get-chat-id.mjs` prints it.
TELEGRAM_CHAT_ID=123456789
# Optional. Only set this if the finished VIDEO should go to a different
# bot chat than the reports. It must also be a private chat; when unset
# the video uses TELEGRAM_CHAT_ID. Either way the build refuses to start
# unless every destination is a one-to-one chat with the bot.
# TELEGRAM_REVIEW_CHAT_ID=123456789

# Reddit — رایگان: در reddit.com/prefs/apps یک app از نوع "script" بسازید
REDDIT_CLIENT_ID=
REDDIT_SECRET=

# Exa — the only PAID image index in LAW 7 (layer 3). Off by default so a
# build costs nothing: Pexels, Wikimedia, DuckDuckGo, Pollinations, our own
# assets and the local graphic are all keyless or free-tier. The key stays
# registered; set the flag to true to spend on it.
ENABLE_EXA=false
EXA_API_KEY=

# Google Flow has no standalone automation API. The official programmable
# route is Gemini API Veo. Explicit opt-in prevents any surprise billed call.
GOOGLE_VEO_API_KEY=
ENABLE_GOOGLE_VEO=false
GOOGLE_VEO_MODEL=veo-3.1-fast-generate-preview
